<%- include('../partials/head') %> <%- include('../partials/nav', { isLoggedIn:
true, showGroupButtons: true, currentGroupId: groupId }) %>

<body
  class="bg-gradient-to-br from-blue-50 via-indigo-50 to-purple-50 min-h-screen"
>
  <main class="container mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="max-w-2xl mx-auto">
      <!-- Header -->
      <div class="text-center mb-8">
        <div class="mb-4">
          <div
            class="w-16 h-16 bg-gradient-to-r from-green-500 to-emerald-600 rounded-full flex items-center justify-center mx-auto shadow-lg"
          >
            <svg
              class="w-8 h-8 text-white"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"
              />
            </svg>
          </div>
        </div>
        <h1
          class="text-3xl sm:text-4xl font-bold bg-gradient-to-r from-green-600 to-emerald-600 bg-clip-text text-transparent mb-4"
        >
          Make Payment
        </h1>
        <p class="text-lg text-gray-600">
          Pay
          <span class="font-semibold"
            ><%= toUser.firstName %> <%= toUser.lastName %></span
          >
        </p>
      </div>

      <!-- Payment Form -->
      <div
        class="bg-white/70 backdrop-blur-sm rounded-2xl shadow-xl p-6 sm:p-8 border border-white/20"
      >
        <form
          action="/user/groups/<%= groupId %>/pay/<%= toUser._id %>"
          method="POST"
          class="space-y-6"
        >
          <!-- Amount Section -->
          <div>
            <label
              class="block text-lg font-semibold text-gray-800 mb-3 flex items-center"
            >
              <svg
                class="w-5 h-5 mr-2 text-green-600"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1"
                />
              </svg>
              Amount to Pay
            </label>
            <div class="relative">
              <span
                class="absolute left-4 top-1/2 transform -translate-y-1/2 text-gray-500 font-medium"
                >₹</span
              >
              <input
                type="number"
                name="amount"
                value="<%= owedAmount %>"
                readonly
                class="w-full pl-8 pr-4 py-4 bg-green-50 border-2 border-green-200 rounded-xl text-xl font-bold text-green-800 cursor-not-allowed"
              />
            </div>
            <p class="text-sm text-gray-600 mt-2">
              This is the total amount you owe to <%= toUser.firstName %>
            </p>
          </div>

          <!-- Recipient Info -->
          <div>
            <label
              class="block text-lg font-semibold text-gray-800 mb-3 flex items-center"
            >
              <svg
                class="w-5 h-5 mr-2 text-blue-600"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
                />
              </svg>
              Paying To
            </label>
            <div
              class="bg-blue-50 border-2 border-blue-200 rounded-xl p-4 flex items-center space-x-3"
            >
              <div
                class="w-12 h-12 bg-gradient-to-r from-blue-500 to-indigo-600 rounded-full flex items-center justify-center text-white font-semibold"
              >
                <%= (toUser.firstName.charAt(0) + (toUser.lastName ?
                toUser.lastName.charAt(0) : '')).toUpperCase() %>
              </div>
              <div>
                <h3 class="text-lg font-semibold text-gray-800">
                  <%= toUser.firstName %> <%= toUser.lastName %>
                </h3>
                <p class="text-sm text-gray-600"><%= toUser.email %></p>
              </div>
            </div>
          </div>

          <!-- UPI Payment Section -->
          <div>
            <label
              class="block text-lg font-semibold text-gray-800 mb-3 flex items-center"
            >
              <svg
                class="w-5 h-5 mr-2 text-purple-600"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"
                />
              </svg>
              UPI Payment
            </label>
            <% if (toUser.upiLink) { %>
            <div
              class="bg-purple-50 border-2 border-purple-200 rounded-xl p-4 space-y-4"
            >
              <div class="flex items-center justify-between">
                <div>
                  <p class="text-sm text-purple-800 font-medium">UPI ID</p>
                  <p class="text-lg font-semibold text-purple-900">
                    <%= toUser.upiLink %>
                  </p>
                </div>
                <svg
                  class="w-8 h-8 text-purple-600"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"
                  />
                </svg>
              </div>
              <a
                href="upi://pay?pa=<%= toUser.upiLink %>&am=<%= owedAmount %>&cu=INR"
                target="_blank"
                class="block w-full bg-gradient-to-r from-purple-600 to-indigo-600 text-white py-3 px-4 rounded-xl font-semibold text-center shadow-lg hover:shadow-xl transform hover:scale-105 transition-all duration-200"
              >
                <svg
                  class="w-5 h-5 inline mr-2"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-2M7 9l8-8m0 0l-8 8M15 1v6h6"
                  />
                </svg>
                Pay ₹<%= parseFloat(owedAmount).toFixed(2) %> via UPI
              </a>
            </div>
            <% } else { %>
            <div
              class="bg-gray-50 border-2 border-gray-200 rounded-xl p-4 text-center"
            >
              <svg
                class="w-8 h-8 text-gray-400 mx-auto mb-2"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.732-.833-2.464 0L4.35 16.5C3.58 17.333 4.54 19 6.082 19z"
                />
              </svg>
              <p class="text-gray-600 font-medium">UPI ID not provided</p>
              <p class="text-sm text-gray-500">
                Contact <%= toUser.firstName %> for payment details
              </p>
            </div>
            <% } %>
          </div>

          <!-- Payment Mode -->
          <div>
            <label
              class="block text-lg font-semibold text-gray-800 mb-3 flex items-center"
            >
              <svg
                class="w-5 h-5 mr-2 text-orange-600"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                />
              </svg>
              Payment Method
            </label>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <label
                class="flex items-center p-4 bg-white/50 border-2 border-gray-200 rounded-xl cursor-pointer hover:bg-white hover:border-orange-300 transition-all duration-200 has-[:checked]:bg-orange-50 has-[:checked]:border-orange-400"
              >
                <input
                  type="radio"
                  name="mode"
                  value="online"
                  checked
                  class="w-4 h-4 text-orange-600 bg-gray-100 border-gray-300 focus:ring-orange-500"
                />
                <div class="ml-3">
                  <div class="flex items-center space-x-2">
                    <svg
                      class="w-5 h-5 text-orange-600"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"
                      />
                    </svg>
                    <span class="font-medium text-gray-800"
                      >Online Payment</span
                    >
                  </div>
                  <p class="text-sm text-gray-600">UPI, Net Banking, Cards</p>
                </div>
              </label>

              <label
                class="flex items-center p-4 bg-white/50 border-2 border-gray-200 rounded-xl cursor-pointer hover:bg-white hover:border-orange-300 transition-all duration-200 has-[:checked]:bg-orange-50 has-[:checked]:border-orange-400"
              >
                <input
                  type="radio"
                  name="mode"
                  value="cash"
                  class="w-4 h-4 text-orange-600 bg-gray-100 border-gray-300 focus:ring-orange-500"
                />
                <div class="ml-3">
                  <div class="flex items-center space-x-2">
                    <svg
                      class="w-5 h-5 text-orange-600"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"
                      />
                    </svg>
                    <span class="font-medium text-gray-800">Cash Payment</span>
                  </div>
                  <p class="text-sm text-gray-600">Physical cash handover</p>
                </div>
              </label>
            </div>
          </div>

          <!-- Action Buttons -->
          <div class="flex flex-col sm:flex-row gap-4 pt-6">
            <button
              type="submit"
              class="flex-1 bg-gradient-to-r from-green-600 to-emerald-600 text-white py-3 px-6 rounded-xl font-semibold shadow-lg hover:shadow-xl transform hover:scale-105 transition-all duration-200 flex items-center justify-center"
            >
              <svg
                class="w-5 h-5 mr-2"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M5 13l4 4L19 7"
                />
              </svg>
              Confirm Payment
            </button>
            <button
              type="button"
              onclick="window.history.back()"
              class="flex-1 bg-white/70 backdrop-blur-sm border-2 border-gray-200 text-gray-700 py-3 px-6 rounded-xl font-semibold hover:bg-white hover:border-gray-300 hover:shadow-md transition-all duration-200 flex items-center justify-center"
            >
              <svg
                class="w-5 h-5 mr-2"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M6 18L18 6M6 6l12 12"
                />
              </svg>
              Cancel
            </button>
          </div>
        </form>
      </div>

      <!-- Payment Instructions -->
      <div class="mt-8">
        <div
          class="bg-blue-50 border border-blue-200 rounded-xl p-4 text-center"
        >
          <div class="flex items-center justify-center mb-2">
            <svg
              class="w-5 h-5 mr-2 text-blue-600"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
              />
            </svg>
            <span class="text-blue-800 font-medium">Payment Instructions</span>
          </div>
          <p class="text-sm text-blue-700">
            After making the payment, click "Confirm Payment" to notify <%=
            toUser.firstName %>. They will need to approve the payment to mark
            it as settled.
          </p>
        </div>
      </div>
    </div>
  </main>
</body>
