<%- include('../partials/head') %> <%- include('../partials/nav', { isLoggedIn:
true }) %>

<body
  class="bg-gradient-to-br from-blue-50 via-indigo-50 to-purple-50 min-h-screen"
>
  <main class="container mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="max-w-2xl mx-auto">
      <!-- Header Section -->
      <div class="text-center mb-8">
        <div
          class="inline-flex items-center justify-center w-16 h-16 bg-gradient-to-r from-blue-600 to-indigo-600 rounded-full shadow-lg mb-6"
        >
          <svg
            class="w-8 h-8 text-white"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"
            />
          </svg>
        </div>
        <h1
          class="text-3xl font-bold bg-gradient-to-r from-blue-600 to-indigo-600 bg-clip-text text-transparent mb-4"
        >
          Create New Group
        </h1>
        <p class="text-gray-600">
          Set up a new group to start splitting expenses with your friends,
          family, or colleagues
        </p>
      </div>

      <!-- Form Container -->
      <div
        class="bg-white/70 backdrop-blur-sm rounded-2xl shadow-xl p-6 sm:p-8 border border-white/20"
      >
        <% if (errors && errors.length > 0) { %>
        <div
          class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-xl mb-6"
        >
          <div class="flex">
            <div class="flex-shrink-0">
              <svg
                class="h-5 w-5 text-red-400"
                viewBox="0 0 20 20"
                fill="currentColor"
              >
                <path
                  fill-rule="evenodd"
                  d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z"
                  clip-rule="evenodd"
                />
              </svg>
            </div>
            <div class="ml-3">
              <ul class="text-sm space-y-1">
                <% errors.forEach(function(error) { %>
                <li><%= error %></li>
                <% }); %>
              </ul>
            </div>
          </div>
        </div>
        <% } %>

        <form
          id="create-group-form"
          action="/user/create-group"
          method="POST"
          class="space-y-6"
        >
          <!-- Group Name -->
          <div>
            <label
              class="block text-sm font-semibold text-gray-700 mb-2"
              for="groupName"
            >
              Group/Event Name
            </label>
            <div class="relative">
              <div
                class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none"
              >
                <svg
                  class="h-5 w-5 text-gray-400"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"
                  />
                </svg>
              </div>
              <input
                type="text"
                id="groupName"
                name="groupName"
                required
                placeholder="Trip to Goa, Office Lunch, etc."
                class="w-full pl-10 pr-4 py-3 bg-white/50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200 placeholder-gray-400"
              />
            </div>
          </div>

          <!-- Group Description -->
          <div>
            <label
              class="block text-sm font-semibold text-gray-700 mb-2"
              for="groupDescription"
            >
              Description (Optional)
            </label>
            <div class="relative">
              <div
                class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none"
              >
                <svg
                  class="h-5 w-5 text-gray-400"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M4 6h16M4 12h16M4 18h7"
                  />
                </svg>
              </div>
              <input
                type="text"
                id="groupDescription"
                name="groupDescription"
                placeholder="Brief description about the group or event"
                class="w-full pl-10 pr-4 py-3 bg-white/50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200 placeholder-gray-400"
              />
            </div>
          </div>

          <!-- Add Members Section -->
          <div>
            <label
              class="block text-sm font-semibold text-gray-700 mb-2"
              for="userSearch"
            >
              Add Members
            </label>
            <div class="relative">
              <div
                class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none"
              >
                <svg
                  class="h-5 w-5 text-gray-400"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
                  />
                </svg>
              </div>
              <input
                type="text"
                id="userSearch"
                name="userSearch"
                autocomplete="off"
                placeholder="Search by name or email..."
                class="w-full pl-10 pr-4 py-3 bg-white/50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200 placeholder-gray-400"
              />
            </div>

            <!-- Search Results -->
            <div class="relative">
              <ul
                id="searchResults"
                class="absolute z-10 w-full bg-white border border-gray-200 mt-1 rounded-xl shadow-lg max-h-48 overflow-y-auto hidden"
              ></ul>
            </div>

            <!-- Added Members Display -->
            <div class="mt-4">
              <div class="flex items-center justify-between mb-3">
                <span class="text-sm font-medium text-gray-700"
                  >Selected Members</span
                >
                <span id="memberCount" class="text-xs text-gray-500"
                  >0 members</span
                >
              </div>
              <div
                id="addedUsers"
                class="flex flex-wrap gap-2 min-h-[60px] p-3 bg-gray-50/50 rounded-xl border-2 border-dashed border-gray-200"
              >
                <div
                  class="flex items-center justify-center w-full text-gray-400 text-sm"
                >
                  <svg
                    class="w-5 h-5 mr-2"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
                    />
                  </svg>
                  Start typing to search and add members
                </div>
              </div>
            </div>
          </div>

          <!-- Hidden Input -->
          <input type="hidden" name="members" id="membersInput" />

          <!-- Submit Button -->
          <div class="pt-4">
            <button
              type="submit"
              class="w-full py-3 px-4 bg-gradient-to-r from-blue-600 to-indigo-600 text-white font-semibold rounded-xl shadow-lg hover:shadow-xl transform hover:scale-[1.02] transition-all duration-200 hover:from-blue-700 hover:to-indigo-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2"
            >
              <svg
                class="w-5 h-5 inline mr-2"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 6v6m0 0v6m0-6h6m-6 0H6"
                />
              </svg>
              Create Group
            </button>
          </div>
        </form>
      </div>

      <!-- Back Link -->
      <div class="text-center mt-6">
        <a
          href="/user/groups"
          class="inline-flex items-center text-sm text-gray-500 hover:text-gray-700 transition-colors duration-200"
        >
          <svg
            class="w-4 h-4 mr-1"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M15 19l-7-7 7-7"
            />
          </svg>
          Back to Groups
        </a>
      </div>
    </div>
  </main>

  <script>
    const userSearch = document.getElementById("userSearch");
    const searchResults = document.getElementById("searchResults");
    const addedUsers = document.getElementById("addedUsers");
    const membersInput = document.getElementById("membersInput");
    const memberCount = document.getElementById("memberCount");
    let selectedMembers = [];

    userSearch.addEventListener("input", async (e) => {
      const query = e.target.value.trim();
      if (query.length < 2) {
        searchResults.innerHTML = "";
        searchResults.classList.add("hidden");
        return;
      }

      try {
        const res = await fetch(`/user/search?q=${encodeURIComponent(query)}`);
        const users = await res.json();
        searchResults.innerHTML = "";

        if (users.length === 0) {
          searchResults.innerHTML =
            '<li class="px-4 py-3 text-gray-500 text-sm">No users found</li>';
        } else {
          users.forEach((user) => {
            if (!selectedMembers.some((m) => m._id === user._id)) {
              const li = document.createElement("li");
              li.className =
                "px-4 py-3 hover:bg-blue-50 cursor-pointer transition-colors duration-200 border-b border-gray-100 last:border-b-0";
              li.innerHTML = `
                <div class="flex items-center space-x-3">
                  <div class="w-8 h-8 rounded-full flex items-center justify-center text-white text-sm font-semibold ${
                    user.profilePicUrl
                      ? "border-2 border-gray-200"
                      : "bg-gradient-to-r from-blue-400 to-purple-500"
                  }">
                    ${
                      user.profilePicUrl
                        ? `<img src="${
                            user.signedProfilePicUrl || user.profilePicUrl
                          }" alt="${user.firstName} ${
                            user.lastName
                          }" class="w-8 h-8 rounded-full object-cover">`
                        : `${(
                            user.firstName.charAt(0) +
                            (user.lastName ? user.lastName.charAt(0) : "")
                          ).toUpperCase()}`
                    }
                  </div>
                  <div>
                    <div class="font-medium text-gray-900">${user.firstName} ${
                user.lastName
              }</div>
                    <div class="text-sm text-gray-500">${user.email}</div>
                  </div>
                </div>
              `;
              li.addEventListener("click", () => {
                selectedMembers.push(user);
                updateAddedUsers();
                userSearch.value = "";
                searchResults.innerHTML = "";
                searchResults.classList.add("hidden");
              });
              searchResults.appendChild(li);
            }
          });
        }
        searchResults.classList.remove("hidden");
      } catch (error) {
        console.error("Error searching users:", error);
        searchResults.innerHTML =
          '<li class="px-4 py-3 text-red-500 text-sm">Error searching users</li>';
        searchResults.classList.remove("hidden");
      }
    });

    // Hide search results when clicking outside
    document.addEventListener("click", (e) => {
      if (!userSearch.contains(e.target) && !searchResults.contains(e.target)) {
        searchResults.classList.add("hidden");
      }
    });

    function updateAddedUsers() {
      if (selectedMembers.length === 0) {
        addedUsers.innerHTML = `
          <div class="flex items-center justify-center w-full text-gray-400 text-sm">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
            </svg>
            Start typing to search and add members
          </div>
        `;
      } else {
        addedUsers.innerHTML = "";
        selectedMembers.forEach((user, idx) => {
          const div = document.createElement("div");
          div.className =
            "bg-gradient-to-r from-blue-500 to-indigo-600 text-white px-4 py-2 rounded-lg flex items-center space-x-2 shadow-sm";
          div.innerHTML = `
            <div class="w-6 h-6 rounded-full flex items-center justify-center text-xs font-semibold ${
              user.profilePicUrl ? "border border-white/20" : "bg-white/20"
            }">
              ${
                user.profilePicUrl
                  ? `<img src="${
                      user.signedProfilePicUrl || user.profilePicUrl
                    }" alt="${user.firstName} ${
                      user.lastName
                    }" class="w-6 h-6 rounded-full object-cover">`
                  : `${(
                      user.firstName.charAt(0) +
                      (user.lastName ? user.lastName.charAt(0) : "")
                    ).toUpperCase()}`
              }
            </div>
            <span class="text-sm font-medium">${user.firstName} ${
            user.lastName
          }</span>
            <button type="button" class="ml-2 w-5 h-5 bg-white/20 rounded-full flex items-center justify-center hover:bg-white/30 transition-colors duration-200" onclick="removeUser(${idx})">
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
              </svg>
            </button>
          `;
          addedUsers.appendChild(div);
        });
      }

      memberCount.textContent = `${selectedMembers.length} member${
        selectedMembers.length !== 1 ? "s" : ""
      }`;
      membersInput.value = JSON.stringify(selectedMembers.map((u) => u._id));
    }

    window.removeUser = (idx) => {
      selectedMembers.splice(idx, 1);
      updateAddedUsers();
    };

    // Initialize
    updateAddedUsers();
  </script>
</body>
