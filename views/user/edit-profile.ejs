<%- include('../partials/head', { pageTitle: 'Edit Profile - SplitMate' }) %>
<%- include('../partials/nav', { isLoggedIn: true }) %>

<body class="bg-gradient-to-br from-blue-50 via-indigo-50 to-purple-50 min-h-screen">
  <main class="container mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="max-w-2xl mx-auto">
      <!-- Header -->
      <div class="text-center mb-8">
        <div class="mb-4">
          <div class="w-16 h-16 bg-gradient-to-r from-blue-500 to-indigo-600 rounded-full flex items-center justify-center mx-auto shadow-lg">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
            </svg>
          </div>
        </div>
        <h1 class="text-3xl sm:text-4xl font-bold bg-gradient-to-r from-blue-600 to-indigo-600 bg-clip-text text-transparent mb-4">
          Edit Profile
        </h1>
        <p class="text-lg text-gray-600">
          Update your personal information and profile picture
        </p>
      </div>

      <!-- Error/Success Messages -->
      <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
        <div class="mb-6 bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-xl">
          <div class="flex">
            <div class="flex-shrink-0">
              <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"></path>
              </svg>
            </div>
            <div class="ml-3">
              <p class="text-sm"><%= errorMessage %></p>
            </div>
          </div>
        </div>
      <% } %>

      <% if (typeof successMessage !== 'undefined' && successMessage) { %>
        <div class="mb-6 bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-xl">
          <div class="flex">
            <div class="flex-shrink-0">
              <svg class="h-5 w-5 text-green-400" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
            </div>
            <div class="ml-3">
              <p class="text-sm"><%= successMessage %></p>
            </div>
          </div>
        </div>
      <% } %>

      <!-- Profile Form -->
      <div class="bg-white/70 backdrop-blur-sm rounded-2xl shadow-xl p-8 border border-white/20">
        <form action="/user/profile" method="POST" enctype="multipart/form-data" class="space-y-6">
          
          <!-- Profile Picture Section -->
          <div class="text-center">
            <div class="mb-4">
              <div id="current-avatar" class="inline-block">
                <% if (user && user.profilePicUrl) { %>
                  <img
                    id="profile-preview"
                    src="<%= signedProfilePicUrl || user.profilePicUrl %>"
                    alt="Profile Picture"
                    class="h-24 w-24 rounded-full border-4 border-white shadow-lg mx-auto"
                  />
                <% } else { %>
                  <div
                    id="profile-preview"
                    class="h-24 w-24 rounded-full bg-gradient-to-r from-blue-500 to-indigo-600 text-white flex items-center justify-center text-2xl font-bold border-4 border-white shadow-lg mx-auto"
                  >
                    <%= user.firstName.charAt(0).toUpperCase() + user.lastName.charAt(0).toUpperCase() %>
                  </div>
                <% } %>
              </div>
            </div>
            
            <div class="space-y-4">
              <div>
                <label for="profilePicture" class="inline-flex items-center px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors cursor-pointer">
                  <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                  </svg>
                  Choose Photo
                </label>
                <input
                  type="file"
                  id="profilePicture"
                  name="profilePicture"
                  accept="image/*"
                  class="hidden"
                  onchange="previewImage(this)"
                />
              </div>
              
              <% if (user && user.profilePicUrl) { %>
                <button
                  id="remove-photo-btn"
                  type="button"
                  class="text-red-600 hover:text-red-700 text-sm underline"
                  onclick="confirmAndRemovePhoto()"
                >
                  Remove Photo
                </button>
              <% } %>
            </div>
          </div>

          <!-- Personal Information -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- First Name -->
            <div>
              <label for="firstName" class="block text-sm font-semibold text-gray-700 mb-2">
                First Name *
              </label>
              <input
                type="text"
                id="firstName"
                name="firstName"
                value="<%= user.firstName %>"
                required
                class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors bg-white/80 backdrop-blur-sm"
                placeholder="Enter your first name"
              />
            </div>

            <!-- Last Name -->
            <div>
              <label for="lastName" class="block text-sm font-semibold text-gray-700 mb-2">
                Last Name *
              </label>
              <input
                type="text"
                id="lastName"
                name="lastName"
                value="<%= user.lastName %>"
                required
                class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors bg-white/80 backdrop-blur-sm"
                placeholder="Enter your last name"
              />
            </div>
          </div>

          <!-- Email -->
          <div>
            <label for="email" class="block text-sm font-semibold text-gray-700 mb-2">
              Email Address *
            </label>
            <input
              type="email"
              id="email"
              name="email"
              value="<%= user.email %>"
              required
              class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors bg-white/80 backdrop-blur-sm"
              placeholder="Enter your email address"
            />
          </div>

          <!-- Phone -->
          <div>
            <label for="phone" class="block text-sm font-semibold text-gray-700 mb-2">
              Phone Number *
            </label>
            <div class="relative">
              <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
              </div>
              <input
                type="tel"
                id="phone"
                name="phone"
                value="<%= user.phone || '' %>"
                required
                pattern="[6-9][0-9]{9}"
                maxlength="10"
                class="w-full pl-10 pr-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors bg-white/80 backdrop-blur-sm"
                placeholder="9876543210"
              />
            </div>
            <p class="text-xs text-gray-500 mt-1">Required for notifications and updates</p>
          </div>

          <!-- UPI ID/Link -->
          <div>
            <label for="upiLink" class="block text-sm font-semibold text-gray-700 mb-2">
              UPI ID/Link *
            </label>
            <div class="relative">
              <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z" />
                </svg>
              </div>
              <input
                type="text"
                id="upiLink"
                name="upiLink"
                value="<%= user.upiLink || '' %>"
                required
                class="w-full pl-10 pr-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors bg-white/80 backdrop-blur-sm"
                placeholder="yourname@paytm, username@oksbi, mobile@ybl"
              />
            </div>
            <p class="text-xs text-gray-500 mt-1">Required for receiving expense settlements</p>
          </div>

          <!-- Action Buttons -->
          <div class="flex flex-col sm:flex-row gap-4 pt-6">
            <button
              type="submit"
              class="flex-1 bg-gradient-to-r from-blue-600 to-indigo-600 text-white py-3 px-6 rounded-xl hover:from-blue-700 hover:to-indigo-700 transition-all duration-200 font-semibold shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 flex items-center justify-center"
            >
              <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              Save Changes
            </button>
            
            <a
              href="/user/groups"
              class="flex-1 sm:flex-none bg-gray-100 text-gray-700 py-3 px-6 rounded-xl hover:bg-gray-200 transition-colors font-semibold flex items-center justify-center"
            >
              <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
              </svg>
              Cancel
            </a>
          </div>
        </form>
      </div>
    </div>
  </main>

  <!-- JavaScript for Image Preview -->
  <script>
    function previewImage(input) {
      if (input.files && input.files[0]) {
        const reader = new FileReader();
        
        reader.onload = function(e) {
          const preview = document.getElementById('profile-preview');
          
          // Create new img element or update existing one
          if (preview.tagName === 'IMG') {
            preview.src = e.target.result;
          } else {
            // Replace the div with an img
            const newImg = document.createElement('img');
            newImg.id = 'profile-preview';
            newImg.src = e.target.result;
            newImg.alt = 'Profile Picture';
            newImg.className = 'h-24 w-24 rounded-full border-4 border-white shadow-lg mx-auto';
            preview.parentNode.replaceChild(newImg, preview);
          }
        };
        
        reader.readAsDataURL(input.files[0]);
      }
    }

    // Form validation
    document.querySelector('form').addEventListener('submit', function(e) {
      const firstName = document.getElementById('firstName').value.trim();
      const lastName = document.getElementById('lastName').value.trim();
      const email = document.getElementById('email').value.trim();
      
      if (!firstName || !lastName || !email) {
        e.preventDefault();
        alert('Please fill in all required fields (First Name, Last Name, and Email).');
        return false;
      }
      
      // Basic email validation
      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!emailRegex.test(email)) {
        e.preventDefault();
        alert('Please enter a valid email address.');
        return false;
      }
    });

    // Remove photo via fetch to avoid nested forms and keep UX inline
    function confirmAndRemovePhoto() {
      if (!confirm('Are you sure you want to remove your profile picture?')) return;

      fetch('/user/profile/remove-picture', {
        method: 'POST',
        credentials: 'same-origin',
        headers: {
          'Accept': 'text/html'
        }
      })
      .then((res) => {
        if (res.ok) {
          // reload to reflect changes (controller redirects to /user/profile)
          window.location.reload();
        } else {
          return res.text().then(t => { throw new Error(t || 'Failed to remove photo'); });
        }
      })
      .catch((err) => {
        console.error('Remove photo error:', err);
        alert('Failed to remove photo: ' + (err.message || err));
      });
    }
  </script>
</body>
</html>