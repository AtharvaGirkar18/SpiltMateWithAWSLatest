<header
  class="bg-gradient-to-r from-blue-600 to-indigo-600 text-white shadow-2xl w-full sticky top-0 z-50 backdrop-blur-md border-b border-white/10"
>
  <nav class="container mx-auto px-4 sm:px-6 py-4">
    <div class="flex justify-between items-center">
      <!-- Logo Section -->
      <div class="flex items-center space-x-3">
        <div
          class="w-10 h-10 bg-white/90 backdrop-blur-sm rounded-full flex items-center justify-center shadow-lg"
        >
          <svg
            class="w-6 h-6 text-blue-600"
            fill="currentColor"
            viewBox="0 0 20 20"
          >
            <path
              d="M4 4a2 2 0 00-2 2v1h16V6a2 2 0 00-2-2H4zM18 9H2v5a2 2 0 002 2h12a2 2 0 002-2V9zM4 13a1 1 0 011-1h1a1 1 0 110 2H5a1 1 0 01-1-1zm5-1a1 1 0 100 2h1a1 1 0 100-2H9z"
            />
          </svg>
        </div>
        <span
          class="text-2xl font-bold cursor-pointer hover:text-blue-100 transition-colors"
          onclick="window.location.href='/'"
          >SplitMate</span
        >
      </div>

      <!-- Mobile Menu Button -->
      <div class="md:hidden">
        <button
          id="mobile-menu-button"
          class="p-2 rounded-lg bg-white/10 hover:bg-white/20 transition-colors"
          onclick="toggleMobileMenu()"
        >
          <svg
            class="w-6 h-6"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"
            />
          </svg>
        </button>
      </div>

      <!-- Desktop Navigation -->
      <div class="hidden md:flex items-center space-x-3">
        <% if (isLoggedIn) { %> <% if (typeof showGroupButtons === 'undefined'
        || !showGroupButtons) { %>
        <button
          onclick="window.location.href='/user/create-group'"
          class="bg-white/10 backdrop-blur-sm text-white px-4 py-2 rounded-lg hover:bg-white/20 transition-all duration-200 flex items-center space-x-2 border border-white/20"
        >
          <svg
            class="w-4 h-4"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 4v16m8-8H4"
            />
          </svg>
          <span class="hidden lg:inline">Create Group</span>
        </button>
        <% } %> <% if (typeof showGroupButtons !== 'undefined' &&
        showGroupButtons && currentGroupId) { var addExpenseUrl =
        "/user/groups/" + currentGroupId + "/add-expense"; var editGroupUrl =
        "/user/groups/" + currentGroupId + "/edit"; %>

        <button
          onclick="window.location.href='/user/groups'"
          class="bg-white/10 backdrop-blur-sm text-white px-4 py-2 rounded-lg hover:bg-white/20 transition-all duration-200 flex items-center space-x-2 border border-white/20"
        >
          <svg
            class="w-4 h-4"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"
            />
          </svg>
          <span class="hidden lg:inline">Groups</span>
        </button>

        <button
          onclick="window.location.href='<%= addExpenseUrl %>'"
          class="bg-emerald-500/20 backdrop-blur-sm text-white px-4 py-2 rounded-lg hover:bg-emerald-500/30 transition-all duration-200 flex items-center space-x-2 border border-emerald-400/30"
        >
          <svg
            class="w-4 h-4"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 6v6m0 0v6m0-6h6m-6 0H6"
            />
          </svg>
          <span class="hidden lg:inline">Add Expense</span>
        </button>

        <button
          onclick="window.location.href='<%= editGroupUrl %>'"
          class="bg-white/10 backdrop-blur-sm text-white px-4 py-2 rounded-lg hover:bg-white/20 transition-all duration-200 flex items-center space-x-2 border border-white/20"
        >
          <svg
            class="w-4 h-4"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"
            />
          </svg>
          <span class="hidden lg:inline">Edit</span>
        </button>
        <% } %>

        <!-- User Avatar with Dropdown -->
        <div class="ml-4 flex items-center relative">
          <div class="relative">
            <button
              id="user-menu-button"
              class="flex items-center focus:outline-none"
              onclick="toggleUserMenu()"
            >
              <% if (user && user.profilePicUrl) { %>
              <img
                src="<%= signedProfilePicUrl || user.profilePicUrl %>"
                alt="Profile Picture"
                class="h-10 w-10 rounded-full border-2 border-white/20 shadow-lg hover:border-white/40 transition-all cursor-pointer"
              />
              <% } else if (user) { %>
              <div
                class="h-10 w-10 rounded-full bg-white/20 backdrop-blur-sm text-white flex items-center justify-center font-bold border-2 border-white/20 shadow-lg hover:border-white/40 transition-all cursor-pointer"
              >
                <%= (user.firstName.charAt(0) + (user.lastName ?
                user.lastName.charAt(0) : '')).toUpperCase() %>
              </div>
              <% } %>
            </button>

            <!-- Dropdown Menu -->
            <div
              id="user-dropdown"
              class="absolute right-0 mt-2 w-56 rounded-xl bg-white/95 backdrop-blur-md border border-white/20 shadow-2xl z-50 transform origin-top-right scale-95 opacity-0 transition-all duration-200"
              style="display: none"
            >
              <div class="py-2">
                <div class="px-4 py-2 border-b border-gray-200/50">
                  <p class="text-sm font-semibold text-gray-800">
                    <%= user ? user.firstName + ' ' + (user.lastName || '') : ''
                    %>
                  </p>
                  <p class="text-xs text-gray-600">
                    <%= user ? user.email : '' %>
                  </p>
                </div>

                <a
                  href="/user/profile"
                  class="block px-4 py-2 text-sm text-gray-700 hover:bg-blue-50 hover:text-blue-800 transition-colors flex items-center"
                >
                  <svg
                    class="w-4 h-4 mr-3"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
                    ></path>
                  </svg>
                  Edit Profile
                </a>

                <div class="border-t border-gray-200/50 mt-1 pt-1">
                  <a
                    href="/auth/logout"
                    class="block w-full text-left px-4 py-2 text-sm text-red-600 hover:bg-red-50 transition-colors flex items-center"
                  >
                    <svg
                      class="w-4 h-4 mr-3"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"
                      ></path>
                    </svg>
                    Logout
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>

        <% } else { %>
        <a
          href="/auth/login"
          class="bg-white/10 backdrop-blur-sm text-white px-4 py-2 rounded-lg hover:bg-white/20 transition-all duration-200 flex items-center space-x-2 border border-white/20"
        >
          <svg
            class="w-4 h-4"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"
            />
          </svg>
          <span>Login</span>
        </a>
        <a
          href="/auth/signup"
          class="bg-white text-blue-600 px-4 py-2 rounded-lg hover:bg-blue-50 transition-all duration-200 font-medium flex items-center space-x-2 shadow-md"
        >
          <svg
            class="w-4 h-4"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"
            />
          </svg>
          <span>Sign Up</span>
        </a>
        <% } %>
      </div>
    </div>

    <!-- Mobile Navigation Menu -->
    <div
      id="mobile-menu"
      class="hidden md:hidden mt-4 pb-4 border-t border-white/20"
    >
      <div class="space-y-2 pt-4">
        <% if (isLoggedIn) { %>

        <!-- User Avatar in Mobile -->
        <div
          class="flex items-center space-x-3 px-4 py-3 bg-white/10 rounded-lg border border-white/20"
        >
          <% if (user && user.profilePicUrl) { %>
          <img
            src="<%= signedProfilePicUrl || user.profilePicUrl %>"
            alt="Profile Picture"
            class="h-10 w-10 rounded-full border-2 border-white/20 shadow-lg"
          />
          <% } else if (user) { %>
          <div
            class="h-10 w-10 rounded-full bg-white/20 backdrop-blur-sm text-white flex items-center justify-center font-bold border-2 border-white/20 shadow-lg"
          >
            <%= (user.firstName.charAt(0) + (user.lastName ?
            user.lastName.charAt(0) : '')).toUpperCase() %>
          </div>
          <% } %>
          <div class="text-white">
            <div class="font-semibold">
              <%= user ? user.firstName + ' ' + (user.lastName || '') : '' %>
            </div>
            <div class="text-sm text-white/70">
              <%= user ? user.email : '' %>
            </div>
          </div>
        </div>

        <% if (typeof showGroupButtons === 'undefined' || !showGroupButtons) {
        %>
        <button
          onclick="window.location.href='/user/create-group'"
          class="w-full bg-white/10 backdrop-blur-sm text-white px-4 py-3 rounded-lg hover:bg-white/20 transition-all duration-200 flex items-center space-x-3 border border-white/20"
        >
          <svg
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 4v16m8-8H4"
            />
          </svg>
          <span>Create Group</span>
        </button>
        <% } %> <% if (typeof showGroupButtons !== 'undefined' &&
        showGroupButtons && currentGroupId) { var addExpenseUrl =
        "/user/groups/" + currentGroupId + "/add-expense"; var editGroupUrl =
        "/user/groups/" + currentGroupId + "/edit"; %>

        <button
          onclick="window.location.href='/user/groups'"
          class="w-full bg-white/10 backdrop-blur-sm text-white px-4 py-3 rounded-lg hover:bg-white/20 transition-all duration-200 flex items-center space-x-3 border border-white/20"
        >
          <svg
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"
            />
          </svg>
          <span>Groups</span>
        </button>

        <button
          onclick="window.location.href='<%= addExpenseUrl %>'"
          class="w-full bg-emerald-500/20 backdrop-blur-sm text-white px-4 py-3 rounded-lg hover:bg-emerald-500/30 transition-all duration-200 flex items-center space-x-3 border border-emerald-400/30"
        >
          <svg
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 6v6m0 0v6m0-6h6m-6 0H6"
            />
          </svg>
          <span>Add Expense</span>
        </button>

        <button
          onclick="window.location.href='<%= editGroupUrl %>'"
          class="w-full bg-white/10 backdrop-blur-sm text-white px-4 py-3 rounded-lg hover:bg-white/20 transition-all duration-200 flex items-center space-x-3 border border-white/20"
        >
          <svg
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"
            />
          </svg>
          <span>Edit Group</span>
        </button>
        <% } %>

        <button
          onclick="window.location.href='/user/profile'"
          class="w-full bg-white/10 backdrop-blur-sm text-white px-4 py-3 rounded-lg hover:bg-white/20 transition-all duration-200 flex items-center space-x-3 border border-white/20"
        >
          <svg
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
            />
          </svg>
          <span>Edit Profile</span>
        </button>

        <a
          href="/auth/logout"
          class="block w-full bg-red-500/80 backdrop-blur-sm text-white px-4 py-3 rounded-lg hover:bg-red-500 transition-all duration-200 flex items-center space-x-3 border border-red-400/30"
        >
          <svg
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"
            />
          </svg>
          <span>Logout</span>
        </a>
        <% } else { %>
        <a
          href="/auth/login"
          class="w-full bg-white/10 backdrop-blur-sm text-white px-4 py-3 rounded-lg hover:bg-white/20 transition-all duration-200 flex items-center space-x-3 border border-white/20"
        >
          <svg
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"
            />
          </svg>
          <span>Login</span>
        </a>
        <a
          href="/auth/signup"
          class="w-full bg-white text-blue-600 px-4 py-3 rounded-lg hover:bg-blue-50 transition-all duration-200 font-medium flex items-center space-x-3 shadow-md"
        >
          <svg
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"
            />
          </svg>
          <span>Sign Up</span>
        </a>
        <% } %>
      </div>
    </div>
  </nav>

  <script>
    function toggleMobileMenu() {
      const menu = document.getElementById("mobile-menu");
      menu.classList.toggle("hidden");
    }

    function toggleUserMenu() {
      const dropdown = document.getElementById("user-dropdown");
      const isVisible = dropdown.style.display !== "none";

      if (isVisible) {
        dropdown.style.opacity = "0";
        dropdown.style.transform = "scale(0.95)";
        setTimeout(() => {
          dropdown.style.display = "none";
        }, 200);
      } else {
        dropdown.style.display = "block";
        setTimeout(() => {
          dropdown.style.opacity = "1";
          dropdown.style.transform = "scale(1)";
        }, 10);
      }
    }

    // Close dropdown when clicking outside
    document.addEventListener("click", function (event) {
      const dropdown = document.getElementById("user-dropdown");
      const button = document.getElementById("user-menu-button");

      if (
        dropdown &&
        button &&
        !button.contains(event.target) &&
        !dropdown.contains(event.target)
      ) {
        dropdown.style.opacity = "0";
        dropdown.style.transform = "scale(0.95)";
        setTimeout(() => {
          dropdown.style.display = "none";
        }, 200);
      }
    });
  </script>
</header>
